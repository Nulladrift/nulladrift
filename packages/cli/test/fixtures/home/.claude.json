{
  "numStartups": 42,
  "mcpServers": {
    "user-wide": {
      "type": "http",
      "url": "https://user.example.com/mcp"
    }
  },
  "projects": {
    "/workspace/demo": {
      "mcpServers": {
        "project-local": {
          "command": "./bin/local-server",
          "env": { "LOCAL_TOKEN": "s3cret-value-never-written" }
        }
      }
    },
    "/workspace/other": {
      "mcpServers": {
        "belongs-to-another-project": { "command": "nope" }
      }
    }
  }
}
