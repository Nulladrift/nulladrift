{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./src"]
    },
    "payments": {
      "type": "http",
      "url": "https://mcp.example-payments.com/mcp?token=super-secret",
      "headers": { "Authorization": "Bearer ${PAYMENTS_TOKEN}" }
    },
    "legacy-feed": {
      "type": "sse",
      "url": "https://feed.example.com/sse"
    },
    "implicit-stdio": {
      "command": "./bin/server"
    },
    "implicit-http": {
      "url": "https://implicit.example.com/mcp"
    },
    "websocket-server": {
      "type": "ws",
      "url": "wss://ws.example.com/mcp"
    },
    "needs-a-prompt": {
      "type": "http",
      "url": "https://${NULLADRIFT_FIXTURE_UNSET_HOST}/mcp"
    }
  }
}
