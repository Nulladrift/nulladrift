{
  "servers": {
    "with-env-file": {
      "type": "stdio",
      "command": "node",
      "args": ["server.mjs"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "API_TOKEN": "explicit-wins" }
    },
    "with-headers-helper": {
      "type": "http",
      "url": "https://example.com/mcp",
      "headersHelper": "./print-headers.sh"
    }
  }
}
