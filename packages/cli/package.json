{
  "name": "nulladrift",
  "version": "0.10.0",
  "type": "module",
  "description": "Pin what your MCP servers are allowed to do. Fail CI when it changes.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "supply-chain",
    "lockfile",
    "sarif"
  ],
  "bin": {
    "nulladrift": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "example:emit": "tsx src/scripts/emit-example.ts",
    "prepack": "cp ../../README.md ./README.md && cp ../../LICENSE ./LICENSE",
    "crawl": "tsx src/scripts/crawl.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nulladrift/core": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nulladrift/nulladrift.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Nulladrift/nulladrift#readme",
  "bugs": {
    "url": "https://github.com/Nulladrift/nulladrift/issues"
  }
}
