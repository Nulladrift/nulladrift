{
  "name": "@nulladrift/core",
  "version": "0.4.0",
  "type": "module",
  "description": "The lockfile model and the drift engine, shared by the collector and the control plane.",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "tsup",
    "prepack": "cp ../../LICENSE ./LICENSE"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "catalog:",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "tsup": "^8.5.1"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nulladrift/nulladrift.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Nulladrift/nulladrift#readme",
  "bugs": {
    "url": "https://github.com/Nulladrift/nulladrift/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lockfile",
    "drift",
    "security"
  ]
}
